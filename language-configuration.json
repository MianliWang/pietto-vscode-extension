{
  "comments": { "lineComment": "#" },
  "brackets": [ ["(", ")"] ],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [ ["(", ")"], ["\"", "\""], ["'", "'"] ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[^\\s#][^#]*[:(]\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*\\)"
  },
  "onEnterRules": [
    { "beforeText": "^\\s+return\\b(?![^#]*\\(\\s*(?:#.*)?$)", "action": { "indent": "outdent" } }
  ],
  "folding": { "offSide": true },
  "wordPattern": "[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?|[A-Za-z_][A-Za-z_0-9]*"
}
