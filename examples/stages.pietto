shape Metric:
    id: Int
    category: Text
    amount: Int | None

source metrics: Metric = postgres.table("public.metrics")

query grouped:
    from metrics
    group by:
        category
    select:
        category
        total = sum(amount)
        ranked = row_number() window(order by total)

query ranked:
    from metrics
    select:
        id
        row_position = row_number() window(order by id)
    order by:
        row_position
