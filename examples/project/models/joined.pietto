shape AccountRow:
    id: Int
    label: Text | None
    account_key = unique(id)

shape EventRow:
    id: Int
    account_id: Int
    metric: Int | None
    event_key = unique(id)

source accounts: AccountRow = postgres.table("public.accounts")

source events: EventRow = postgres.table("public.events")

query joined:
    from accounts
    let event = events
    left join event on accounts.id == event.account_id
    let key = event.account_id
    select:
        account_id = accounts.id
        event_id = event.id
        bound_key = key
        ranked = row_number() window(order by event.id)
    qualify:
        ranked <= 3
