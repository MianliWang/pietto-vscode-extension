{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pietto Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.vscode-test/development-user-data",
        "--extensions-dir=${workspaceFolder}/.vscode-test/development-extensions",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "Build Pietto extension"
    }
  ]
}
