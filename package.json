{
  "name": "pietto-vscode-extension",
  "displayName": "Pietto",
  "description": "Compiler-backed Pietto editing and declared model and connection preview.",
  "version": "0.1.0",
  "publisher": "MianliWang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MianliWang/pietto-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:pietto",
    "onView:pietto.models",
    "onView:pietto.connections"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax editing is available. Compiler analysis requires Workspace Trust.",
      "restrictedConfigurations": [
        "pietto.pythonPath",
        "pietto.pythonArguments"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "pietto",
        "aliases": [
          "Pietto"
        ],
        "extensions": [
          ".pietto"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pietto",
        "scopeName": "source.pietto",
        "path": "./syntaxes/pietto.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pietto",
        "path": "./snippets/pietto.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pietto.models",
          "name": "Pietto Models"
        },
        {
          "id": "pietto.connections",
          "name": "Pietto Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "pietto.refresh",
        "title": "Pietto: Refresh Models and Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "pietto.selectPython",
        "title": "Pietto: Select Python Interpreter"
      },
      {
        "command": "pietto.selectProject",
        "title": "Pietto: Select Explicit Project Root"
      },
      {
        "command": "pietto.clearProject",
        "title": "Pietto: Use Single File Mode"
      },
      {
        "command": "pietto.configureConnections",
        "title": "Pietto: Configure Connection Preview",
        "icon": "$(gear)"
      },
      {
        "command": "pietto.reveal",
        "title": "Pietto: Reveal Current Declaration",
        "icon": "$(target)"
      },
      {
        "command": "pietto.copyFieldPath",
        "title": "Pietto: Copy Qualified Field Path",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pietto.refresh",
          "when": "view == pietto.models || view == pietto.connections",
          "group": "navigation"
        },
        {
          "command": "pietto.reveal",
          "when": "view == pietto.models",
          "group": "navigation"
        },
        {
          "command": "pietto.configureConnections",
          "when": "view == pietto.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pietto.copyFieldPath",
          "when": "view == pietto.models && viewItem == pietto.field"
        }
      ]
    },
    "configuration": {
      "title": "Pietto",
      "properties": {
        "pietto.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine-overridable",
          "description": "Python interpreter containing the compatible Pietto compiler. No automatic installation."
        },
        "pietto.analysisDelay": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Edit debounce in milliseconds."
        },
        "pietto.analysisTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Compiler request timeout in milliseconds.",
          "scope": "resource"
        },
        "pietto.pythonArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Optional interpreter launcher arguments. Windows project checking: wsl.exe with -d, distribution, --, isolated Linux Python path."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "pietto-connections.json",
        "url": "./schemas/connections.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint src tests",
    "test": "npm run build && node --test out/tests/*.test.js",
    "test:adapter": "node scripts/testAdapter.cjs",
    "test:host": "npm run build && node out/tests/runHost.js",
    "verify": "npm run lint && npm test && npm run test:adapter && npm run test:host && npm run test:restricted",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out artifacts/pietto-0.1.0.vsix",
    "test:restricted": "npm run build && node out/tests/runRestrictedHost.js",
    "test:vsix": "npm run build && node out/tests/runVsix.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
