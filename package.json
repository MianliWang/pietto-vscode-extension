{
  "name": "pietto-vscode-extension",
  "displayName": "Pietto",
  "description": "Pietto highlighting and snippets, with diagnostics from the pietto lsp language server.",
  "version": "0.3.0",
  "publisher": "MianliWang",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B2A6B",
    "theme": "dark"
  },
  "keywords": [
    "pietto",
    "sql",
    "postgresql",
    "mysql",
    "lsp",
    "query language"
  ],
  "homepage": "https://github.com/MianliWang/pietto",
  "bugs": {
    "url": "https://github.com/MianliWang/pietto-vscode-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MianliWang/pietto-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:pietto"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting, snippets and folding work. Diagnostics start pietto lsp from the selected Python and need Workspace Trust.",
      "restrictedConfigurations": [
        "pietto.pythonPath",
        "pietto.pythonArguments"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "pietto",
        "aliases": [
          "Pietto"
        ],
        "extensions": [
          ".pietto"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/pietto-file-light.svg",
          "dark": "./images/pietto-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pietto",
        "scopeName": "source.pietto",
        "path": "./syntaxes/pietto.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pietto",
        "path": "./snippets/pietto.json"
      }
    ],
    "commands": [
      {
        "command": "pietto.selectPython",
        "title": "Pietto: Select Python Interpreter"
      },
      {
        "command": "pietto.selectProject",
        "title": "Pietto: Select Explicit Project Root"
      },
      {
        "command": "pietto.clearProject",
        "title": "Pietto: Use Single File Mode"
      },
      {
        "command": "pietto.restart",
        "title": "Pietto: Restart Language Server"
      },
      {
        "command": "pietto.previewPostgresSql",
        "title": "Pietto: Preview PostgreSQL SQL (Single File)"
      },
      {
        "command": "pietto.previewSql",
        "title": "Pietto: Preview SQL (Single File)"
      },
      {
        "command": "pietto.previewProjectSql",
        "title": "Pietto: Preview Project SQL (Module)"
      },
      {
        "command": "pietto.refreshModels",
        "title": "Pietto: Refresh Models",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pietto.models",
          "name": "Pietto Models",
          "when": "pietto.activated"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pietto.models",
        "contents": "No Pietto project root is selected. This view lists the columns of every table and query of each root in pietto.projectRoots, from its saved files.\n[Select Project Root](command:pietto.selectProject)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pietto.refreshModels",
          "when": "view == pietto.models",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pietto",
      "properties": {
        "pietto.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine-overridable",
          "description": "Python interpreter that has pietto 0.1.10 or later installed; the extension runs its pietto lsp. Nothing is installed automatically."
        },
        "pietto.pythonArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Optional launcher arguments placed before the interpreter's own arguments. Windows desktop with a WSL interpreter: set pietto.pythonPath to wsl.exe and these to -d, the distribution, --, the Linux Python path."
        },
        "pietto.projectRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Explicit Pietto project roots (folders that hold pietto.toml), each the same as pietto check --project ROOT. Relative paths resolve against the workspace folder. Empty: every open file is checked as a single file."
        },
        "pietto.sqlDialect": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql"
          ],
          "enumDescriptions": [
            "PostgreSQL",
            "MySQL"
          ],
          "default": "postgres",
          "scope": "resource",
          "description": "The emit-sql --dialect of Pietto: Preview SQL (Single File) and Pietto: Preview Project SQL (Module). A command argument {\"dialect\": \"mysql\"} overrides it."
        },
        "pietto.emissionContract": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The emission contract file that Pietto: Preview Project SQL (Module) passes as emit-sql --emission-contract: a path relative to the project root with / separators, such as contract.json. Its target family must be the selected dialect. A command argument {\"emissionContract\": \"...\"} overrides it."
        },
        "pietto.targetDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "After a save, show as Warnings in the Problems panel what pietto emit-sql refuses for the pietto.sqlDialect target: backend refusals (PIE-B…) and emit-sql's own errors. It reads the saved files: a project root runs emit-sql --project ROOT --all with pietto.emissionContract and is skipped without one; a Pietto file outside every root runs emit-sql FILE."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint src tests",
    "test": "npm run build && node --test out/tests/*.test.js",
    "test:host": "npm run build && node out/tests/runHost.js",
    "test:restricted": "npm run build && node out/tests/runRestrictedHost.js",
    "test:vsix": "npm run build && node out/tests/runVsix.js",
    "verify": "npm run lint && npm test && npm run test:host && npm run test:restricted",
    "vscode:prepublish": "npm run build",
    "package": "node -e \"require('node:fs').mkdirSync('artifacts', {recursive: true})\" && vsce package --out artifacts"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
